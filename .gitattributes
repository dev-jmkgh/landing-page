# =============================================================================
# Line endings
#
# This project is developed on Windows (core.autocrlf=true) but deployed to a
# Linux server. Files that Apache, MySQL or a shell has to parse must arrive
# with LF endings, so they are pinned here regardless of the local git config.
# =============================================================================

# Normalise everything text-like in the repository to LF.
* text=auto eol=lf

# Server-parsed files — CRLF here can break Apache directives and shell scripts.
.htaccess       text eol=lf
*.sh            text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.env.example   text eol=lf

# Source and config.
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.json          text eol=lf
*.css           text eol=lf
*.md            text eol=lf
*.html          text eol=lf
*.svg           text eol=lf

# Binary — never touched by line-ending conversion or diffed as text.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.pdf           binary

# Keep generated lockfiles out of diffs and merge noise.
package-lock.json  -diff linguist-generated=true
