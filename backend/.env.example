# =============================================================================
# JMK Global Holdings — API environment
# Copy to `.env` and fill in real values. NEVER commit the .env file.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Set to 1 when the API runs behind a reverse proxy (Hostinger, Nginx, Cloudflare)
# so rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=0

# --- URLs & CORS --------------------------------------------------------------
# Public origin of the website (used in email links).
APP_URL=http://localhost:3000

# Comma-separated list of browser origins allowed to call this API.
# Production example:
# CORS_ORIGINS=https://www.jmkglobalholdings.com,https://jmkglobalholdings.com
#
# Sharing a local demo over a VS Code dev tunnel? Add the tunnel's *web* origin here
# (the port-3000 one). Trailing slashes are ignored. You must also forward port 5000
# and point NEXT_PUBLIC_API_BASE_URL at it — "localhost" in a shared link resolves to
# the visitor's own machine, not yours. Set both ports' visibility to Public, and set
# COOKIE_SAMESITE=none below, because the two tunnel hosts count as different sites.
# CORS_ORIGINS=http://localhost:3000,https://<id>-3000.<region>.devtunnels.ms
CORS_ORIGINS=http://localhost:3000

# --- Database (MySQL) ---------------------------------------------------------
# Either set DATABASE_URL, or the discrete DB_* values below.
# DATABASE_URL=mysql://user:password@localhost:3306/jmk_global
DB_HOST=localhost
DB_PORT=3306
DB_USER=jmk_user
DB_PASSWORD=
DB_NAME=jmk_global
DB_CONNECTION_LIMIT=10

# --- Gmail SMTP ---------------------------------------------------------------
# Use a Gmail APP PASSWORD (Google Account ▸ Security ▸ 2-Step Verification ▸
# App passwords). Never use the normal account password.
# --- Mail transport ----------------------------------------------------------
# 'smtp' sends through any SMTP server — currently the Brevo relay; 'ses' sends
# through Amazon SES.
# Templates, attachments, the logo, reply-to handling and delivery reporting are
# identical either way — switching provider is this one value and nothing else.
#
# CURRENTLY smtp, AND NOT BY PREFERENCE. AWS declined production access for the SES
# account, which leaves it in the sandbox, where SES only delivers to addresses that
# are themselves verified identities. That rules SES out for this application: the
# confirmations go to enquirers and applicants whose addresses cannot be verified in
# advance. Measured while sandboxed — an ordinary Gmail address was rejected with
# MessageRejected; the same address delivered fine over SMTP.
#
# TO SWITCH BACK once AWS grants production access:
#   1. MAIL_PROVIDER=ses
#   2. leave SMTP_FROM_EMAIL blank — it then defaults to no-reply@jmkglobalholdings.com,
#      which sits on the verified domain identity and is DKIM-signed
#   3. restart; the boot log warns if the account is still sandboxed
# The SMTP_* values can stay in place; they are simply unused while SES is selected.
MAIL_PROVIDER=smtp

# SES only, and unused while MAIL_PROVIDER=smtp. Not a secret.
#
# There are deliberately NO AWS credential variables in this file. The AWS SDK
# resolves credentials itself — environment, shared config, then the EC2 instance
# role — so on an EC2 box the correct setup is an instance role and no keys on
# disk at all. If you do set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the
# environment the SDK will pick them up, but an instance role is preferred and
# needs no change here.
AWS_REGION=ap-south-1

# --- Resume storage ----------------------------------------------------------
# 'local' keeps resumes on the instance disk; 's3' keeps them in a bucket.
#
# On a single EC2 box the disk is the one thing with no backup — the nightly
# mysqldump does not cover uploaded files — so 's3' is the durable choice.
#
# The bucket MUST be private. Resumes are personal data. They are served only
# through the authenticated admin route or a short-lived signed link, never by a
# public URL. Recommended bucket settings:
#   - Block all public access: ON
#   - Default encryption: SSE-S3 (or SSE-KMS)
#   - Lifecycle rule to expire objects after your retention period
#   - CORS allowing PUT from your site origin, so the browser can upload directly
STORAGE_DRIVER=local
S3_BUCKET=
S3_PREFIX=resumes

# Where this API is reachable from outside. Used to build the resume download
# link in the admin notification email, so it must be the public API host.
API_PUBLIC_URL=http://localhost:5000

# Leave SMTP_USER/SMTP_PASSWORD blank to disable email while developing —
# enquiries are still validated and stored.
#
# BREVO (current). The login is a service credential, not a mailbox: it looks like
# b7xxxxxxx@smtp-brevo.com and must never appear in the From — set SMTP_FROM_EMAIL
# explicitly below. The password is the SMTP key from Brevo, not the account
# password. Port 587 is STARTTLS, so SMTP_SECURE must be false; 587 with secure=true
# hangs until the connection times out, which looks like "email silently does
# nothing". The mismatch is reported at startup.
#
# The sender must be authorised in Brevo — either the domain is authenticated or the
# address is added as a verified sender — or Brevo refuses the message.
#
# GMAIL, if ever switched back: host smtp.gmail.com, port 465, secure true, and the
# password must be a 16-character App Password. Gmail is the one transport where the
# authenticated account is also the sender, so leave SMTP_FROM_EMAIL blank there and
# it will send as SMTP_USER. Anything else fails DMARC and lands in spam.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=JMK Global Holdings Website
# REQUIRED on a relay such as Brevo. The fallback when this is blank depends on the
# transport: Gmail falls back to SMTP_USER, which is correct there, but every other
# transport falls back to no-reply@jmkglobalholdings.com — because SMTP_USER on a
# relay is a service login like b7xxxxxxx@smtp-brevo.com and must never be the From.
#
# On MAIL_PROVIDER=ses this same default applies and the address must be a VERIFIED
# IDENTITY in the SES region above, or SES refuses the send.
#
# On Gmail only:
# IMPORTANT: leave blank unless this address is a VERIFIED ALIAS on the SMTP_USER
# account. A From address on a different domain to the authenticated account is
# accepted by Gmail but fails SPF/DKIM alignment at the receiving end, so the mail
# is filed as spam - which looks exactly like "no emails are being sent".
# Replies still reach the business inbox via Reply-To either way.
SMTP_FROM_EMAIL=no-reply@jmkglobalholdings.com

# --- Administrative notification recipients -----------------------------------
# THE single source of truth for who receives website enquiries and career
# applications. Comma-separated; every address receives every notification.
# Never hard-coded in the application - change the inbox list here only.
#   ADMIN_EMAILS=info@example.com,hr@example.com,careers@example.com
ADMIN_EMAILS=

# --- Admin authentication -----------------------------------------------------
# Fallback administrator used when the admin_users table is empty.
# This is a SIGN-IN identity, not a notification recipient - notifications go to
# ADMIN_EMAILS above.
# Generate the hash with:  npm run hash:password -- "YourStrongPassword"
ADMIN_LOGIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Secret used to sign admin session tokens. Minimum 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_TTL_HOURS=8
# Use "none" only if the site and API are on different registrable domains
# (requires HTTPS on both). "lax" is correct for www./api. on the same domain.
COOKIE_SAMESITE=lax

# --- reCAPTCHA (v2 checkbox) ---------------------------------------------------
# Server-side secret from https://www.google.com/recaptcha/admin - NEVER commit the
# real value and never expose it to the browser. Leave blank to disable verification
# (honeypot, timing check and rate limits still apply).
RECAPTCHA_SECRET_KEY=
# Only used if a v3 key is swapped in; v2 responses carry no score.
RECAPTCHA_MIN_SCORE=0.5
# 1 = reject submissions when Google is unreachable. Default 0 (fail open), so a
# Google outage does not silently cost you enquiries.
RECAPTCHA_FAIL_CLOSED=0

# --- Uploads ------------------------------------------------------------------
# Directory for resume files. Keep it OUTSIDE the public web root.
UPLOAD_DIR=storage/resumes
MAX_UPLOAD_MB=5

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
FORM_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_MAX=10

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info

# --- Tooling only -------------------------------------------------------------
# Read by the scripts below, never by the running server. All have safe defaults,
# so leave them unset unless you need to override the behaviour.
#
# Absolute path override for the migration runner (npm run db:migrate). By default it
# finds backend/database/migrations on its own.
# MIGRATIONS_DIR=
#
# Used only by `npm run db:seed` when creating the first administrator.
# SEED_ADMIN_EMAIL falls back to ADMIN_LOGIN_EMAIL above; SEED_ADMIN_PASSWORD must be at
# least 12 characters and is hashed with bcrypt before it is stored.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
