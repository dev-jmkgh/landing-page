{
  "name": "jmk-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "JMK Global Holdings — corporate website (Next.js App Router, static export)",
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/generate-og-image.mjs",
