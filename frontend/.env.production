# ---------------------------------------------------------------------------
# Frontend environment — PRODUCTION
#
# Next loads this file automatically when NODE_ENV is production, which
# `next build` sets itself. `deploy/deploy.sh` refuses to run without it.
#
# Every NEXT_PUBLIC_* value is inlined into the static bundle at build time and
# is therefore public by definition. NOTHING SECRET GOES IN THIS FILE — the
# values below are all already readable in the shipped JavaScript, and in fact
# every one of them was read back off the live site to write this file.
#
# PRECEDENCE WARNING. Next's load order puts `.env.local` ABOVE this file:
#
#     .env.production.local  >  .env.local  >  .env.production  >  .env
#
# So a `.env.local` sitting in this directory silently wins, and on the server
# that means shipping a build pointing at localhost. `deploy.sh` now fails if it
# finds one rather than letting it through.
# ---------------------------------------------------------------------------

# Canonical public origin, no trailing slash.
#
# The apex, not www. Both answer 200 with no redirect between them, and the
# canonical tag the live site currently serves is the apex — so this matches
# what is deployed. (`.env.example` suggested www, which did not.)
NEXT_PUBLIC_SITE_URL=https://jmkglobalholdings.com

# Served from the domain root, so no sub-path. Only GitHub Pages project sites
# need this, and its workflow sets it itself.
NEXT_PUBLIC_BASE_PATH=

# Base URL of the Express API, including the /api prefix.
NEXT_PUBLIC_API_BASE_URL=https://api.jmkglobalholdings.com/api

# Left blank deliberately: no official channel URL has been supplied, so the
# footer and contact YouTube links stay hidden rather than pointing nowhere.
NEXT_PUBLIC_YOUTUBE_URL=

# Blank renders the accessible static map placeholder with a "Get directions"
# link, which is a working fallback rather than an empty frame.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# reCAPTCHA v2 site key. Public by design — it is embedded in the page HTML.
# This is the key the live site is already using.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LdAg34tAAAAABGX0N_Frb412nVyp__WGjDxNy9A

# Optional Search Console token. Verification is already established by other
# means, so this stays empty.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Analytics ---------------------------------------------------------------
# Setting either of these changes what the site tells visitors about itself:
# the privacy policy's Cookies section reads from these same flags and describes
# whichever is actually enabled.
#
# GA is on in production and this is the measurement ID the live site serves.
# Clarity is off, and the live pages load no Clarity tag.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-40K7TTL7V4
NEXT_PUBLIC_CLARITY_PROJECT_ID=
