# ---------------------------------------------------------------------------
# Frontend environment (Next.js) — copy to .env.local for development
# Every NEXT_PUBLIC_* value is inlined into the static bundle at build time,
# so it MUST NOT contain secrets of any kind.
# ---------------------------------------------------------------------------

# Canonical public origin, no trailing slash. Used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.jmkglobalholdings.com

# Base URL of the Express API (includes the /api prefix).
# Development: http://localhost:5000/api
# Production:  https://api.jmkglobalholdings.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Official YouTube channel URL. Left blank on purpose — the document did not supply one,
# so the footer/contact YouTube link stays hidden until a real URL is added here.
NEXT_PUBLIC_YOUTUBE_URL=

# Google Maps embed URL for the Coimbatore office (Maps ▸ Share ▸ Embed a map ▸ copy src).
# Blank renders an accessible static map placeholder with a "Get directions" link instead.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Optional: Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
