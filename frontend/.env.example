# ---------------------------------------------------------------------------
# Frontend environment (Next.js) — copy to .env.local for development
# Every NEXT_PUBLIC_* value is inlined into the static bundle at build time,
# so it MUST NOT contain secrets of any kind.
# ---------------------------------------------------------------------------

# Canonical public origin, no trailing slash. Used for canonical URLs, sitemap and OG tags.
#
# The apex, without www. Both hostnames answer and neither redirects to the other, so the
# canonical tag is what decides — and production serves the apex. This said www, which
# did not match what is deployed.
NEXT_PUBLIC_SITE_URL=https://jmkglobalholdings.com

# Sub-path the site is served from. Empty for a domain root (production, S3/CloudFront).
# GitHub Pages project sites need "/<repo>"; the Pages workflow sets this automatically.
NEXT_PUBLIC_BASE_PATH=

# Base URL of the Express API (includes the /api prefix).
# Development: http://localhost:5000/api
# Production:  https://api.jmkglobalholdings.com/api
# Leave EMPTY for a front-end-only deployment: the forms then state that submissions
# cannot be received yet instead of failing obscurely.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Official YouTube channel URL. Left blank on purpose — the document did not supply one,
# so the footer/contact YouTube link stays hidden until a real URL is added here.
NEXT_PUBLIC_YOUTUBE_URL=

# Google Maps embed URL for the Coimbatore office (Maps ▸ Share ▸ Embed a map ▸ copy src).
# Blank renders an accessible static map placeholder with a "Get directions" link instead.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# reCAPTCHA v2 ("I am not a robot") site key. Public by design - it is embedded in
# the page HTML. Leave blank to disable the checkbox locally; the submit buttons then
# behave normally and the backend skips verification too.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LdAg34tAAAAABGX0N_Frb412nVyp__WGjDxNy9A

# Optional: Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Analytics (optional) -----------------------------------------------------
# Both are off unless set. When neither is set the build ships no third-party
# script and sets no analytics cookie — and the privacy policy's Cookies section
# reads from these same flags, so it states whichever is actually true.
#
# Setting either one makes the policy describe it. Keep that in mind: turning
# analytics on is a change to what the site tells visitors about itself.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
