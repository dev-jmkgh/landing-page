# =============================================================================
# JMK Global Holdings — every environment variable in one place
#
# This file is a REFERENCE. The application reads two separate files:
#   frontend/.env.local  (see frontend/.env.example)  — build-time, public
#   backend/.env         (see backend/.env.example)   — runtime, secret
#
# Copy the relevant block into the matching file. Never commit a real .env.
# =============================================================================


# -----------------------------------------------------------------------------
# FRONTEND  →  frontend/.env.local
# Everything here is compiled into the public JavaScript bundle. No secrets.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.jmkglobalholdings.com
# Sub-path for GitHub Pages project sites; empty at a domain root.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_BASE_URL=https://api.jmkglobalholdings.com/api
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LdAg34tAAAAABGX0N_Frb412nVyp__WGjDxNy9A
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# -----------------------------------------------------------------------------
# BACKEND  →  backend/.env
# Secret. Never exposed to the browser, never committed.
# -----------------------------------------------------------------------------

# Runtime
NODE_ENV=production
PORT=5000
TRUST_PROXY=1

# URLs & CORS
APP_URL=https://www.jmkglobalholdings.com
CORS_ORIGINS=https://www.jmkglobalholdings.com,https://jmkglobalholdings.com

# Database (MySQL) — DATABASE_URL takes precedence over the DB_* values
# DATABASE_URL=mysql://user:password@localhost:3306/jmk_global
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10

# Gmail SMTP — SMTP_PASSWORD must be a Gmail App Password, not the account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=JMK Global Holdings Website
# IMPORTANT: leave blank unless this address is a VERIFIED ALIAS on the SMTP_USER
# account. A From address on a different domain to the authenticated account is
# accepted by Gmail but fails SPF/DKIM alignment at the receiving end, so the mail
# is filed as spam - which looks exactly like "no emails are being sent".
# Replies still reach the business inbox via Reply-To either way.
SMTP_FROM_EMAIL=

# --- Administrative notification recipients -----------------------------------
# THE single source of truth for who receives website enquiries and career
# applications. Comma-separated; every address receives every notification.
# Never hard-coded in the application - change the inbox list here only.
#   ADMIN_EMAILS=info@example.com,hr@example.com,careers@example.com
ADMIN_EMAILS=

# Admin authentication
# ADMIN_PASSWORD_HASH: npm run hash:password -- "YourStrongPassword"
# JWT_SECRET:          node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_LOGIN_EMAIL=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
SESSION_TTL_HOURS=8
COOKIE_SAMESITE=lax

# reCAPTCHA v2 — secret key, server-side only. Never commit the real value.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_FAIL_CLOSED=0

# Uploads — must stay outside public_html
UPLOAD_DIR=storage/resumes
MAX_UPLOAD_MB=5

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
FORM_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info

# Tooling only — read by npm scripts, never by the running server. All optional.
# MIGRATIONS_DIR=          # absolute path override for `npm run db:migrate`
# SEED_ADMIN_EMAIL=        # `npm run db:seed`; defaults to ADMIN_LOGIN_EMAIL
# SEED_ADMIN_PASSWORD=     # `npm run db:seed`; min 12 chars, hashed before storage
