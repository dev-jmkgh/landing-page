# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
build/
out/
.next/
.next-build/
.next-*/
frontend/out/
frontend/.next/
frontend/.next-build/
backend/dist/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Runtime data
# ---------------------------------------------------------------------------
# Anchored to the repository root on purpose. A bare `storage/` matches a directory
# of that name at ANY depth, which silently excluded backend/src/services/storage —
# real source, ignored, and the omission only shows up as a missing module on the
# server after a deploy. These rules are meant for uploaded files, nothing else.
/backend/uploads/
/backend/storage/
/uploads/
/storage/
# ---------------------------------------------------------------------------
# Tool caches that end up inside the repo when a command runs without a HOME
# ---------------------------------------------------------------------------
# `sudo -u jmk npm ci` with no -H leaves HOME pointing at the invoking user's
# home, which npm cannot write to, so it falls back to the working directory and
# writes its cache into the checkout. A later `git add -A` then commits thousands
# of _cacache blobs. deploy.sh uses `sudo -u "$APP_USER" -H`, which is the actual
# fix; these rules are the backstop.
.npm/
.npm-cache/
_cacache/
.cache/
.config/configstore/
.node_repl_history

logs/
*.log
npm-debug.log*
yarn-error.log*
pids/
*.pid

# ---------------------------------------------------------------------------
# Generated assets
# The social card is rebuilt by `prebuild` on every build, so it is output,
# not source. Committing it would dirty the tree on every local build.
# ---------------------------------------------------------------------------
frontend/public/images/og/og-default.png

# ---------------------------------------------------------------------------
# Editors / OS / tooling
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Per-developer Claude Code permissions — local to each machine.
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
coverage/
.cache/
.eslintcache
*.local
